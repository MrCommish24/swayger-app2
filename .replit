entrypoint = "README.md"
modules = ["nodejs-22", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", '''npm run expo:static:build && EXPO_PUBLIC_DOMAIN=$(node -e "const d=process.env.REPLIT_INTERNAL_APP_DOMAIN||process.env.REPLIT_DEV_DOMAIN||'';console.log(d.replace(/^https?:\/\//,''))") NODE_OPTIONS=--max-old-space-size=4096 npx expo export --platform web --output-dir dist && npm run server:build''']
run = ["bash", "-c", "PORT=8081 NODE_ENV=production node server_dist/index.js"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5904
externalPort = 3000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3002

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["stripe:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run expo:dev"
waitForPort = 8081
ensurePreviewReachable = "/status"

[userenv]

[userenv.shared]
EXPO_PUBLIC_APP_URL = "https://swayger.app"
RESEND_FROM_EMAIL = "Swayger <noreply@swayger.app>"
EXPO_PUBLIC_POSTHOG_KEY = "phc_r37vsKWdxVK4b4oFSPYr3a7qChnEtT2kNn8emKHAPJry"
EXPO_PUBLIC_ONESIGNAL_APP_ID = "6c7fe969-e694-4977-819a-f10fbc4159c6"
GAMEDAY_HOST_EMAILS = "darius@leagueswype.com"
